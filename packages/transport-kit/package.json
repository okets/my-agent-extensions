{
  "name": "my-agent-transport-kit",
  "version": "0.1.1",
  "description": "Conformance harness, wire-protocol types, and manifest validator for authoring my-agent transport connectors. Certify a connector folder in a clean directory — no framework checkout required.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "my-agent",
    "transport",
    "connector",
    "conformance",
    "claude-agent-sdk",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okets/my-agent-extensions.git",
    "directory": "packages/transport-kit"
  },
  "homepage": "https://github.com/okets/my-agent-extensions/tree/main/packages/transport-kit#readme",
  "bugs": {
    "url": "https://github.com/okets/my-agent-extensions/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "my-agent-transport-kit": "dist/cli.js"
  },
  "main": "dist/lib.js",
  "exports": {
    ".": {
      "import": "./dist/lib.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node build.mjs && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "marked": "^18.0.4",
    "yaml": "^2.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "esbuild": "^0.25.0",
    "typescript": "^6.0.3"
  }
}
